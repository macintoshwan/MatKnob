#include <dt-bindings/led/led.h>
#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/adc/nrf-saadc.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &megknob_layout;
        zmk,underglow = &led_strip;
        /* Dedicated USB CDC ACM virtual serial port for Hall voltage
         * telemetry (see app/module/lib/hall_telemetry), separate and
         * independent from HID/BLE. Enabling
         * this only turns on the telemetry *link*; the actual Kconfig
         * (CONFIG_HALL_TELEMETRY) still has to be enabled in megknob.conf. */
        zmk,hall-telemetry-uart = &hall_telemetry_uart;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-composite";
        rows = <4>;
        columns = <8>;

        adc_mux {
            kscan = <&kscan_adc_mux>;
        };

        wheel {
            kscan = <&kscan_wheel>;
            row-offset = <3>;
        };
    };

    /* Wheel rotation quadrature encoder. The wheel's A/B phases (P0.11,
     * P0.24 against the common P1.11) used to be wired into kscan_wheel as
     * two independent matrix keys, which is electrically wrong for a
     * mechanical encoder: both phases toggle on every detent, so a single
     * rotation in either direction produced two key events instead of one
     * directional step. alps,ec11 decodes the canonical
     * 00 -> 01 -> 11 -> 10 (or reverse) gray-code sequence and reports a
     * single signed delta per detent instead.
     *
     * steps/triggers-per-rotation below are carried over from the previous
     * per-phase GPIO wiring as a starting point and have not been verified
     * against the physical encoder's pulses-per-rotation with a logic
     * analyzer; recheck direction and step count on real hardware before
     * relying on them for anything other than "does turning produce
     * same-signed deltas in one direction". */
    wheel_encoder: wheel_encoder {
        compatible = "alps,ec11";
        status = "okay";
        a-gpios = <&gpio0 11 GPIO_ACTIVE_HIGH>;
        b-gpios = <&gpio0 24 GPIO_ACTIVE_HIGH>;
        steps = <80>;
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&wheel_encoder>;
        triggers-per-rotation = <20>;
    };

    kscan_adc_mux: kscan_adc_mux {
        compatible = "zmk,kscan-adc-mux";
        wakeup-source;
        address-gpios
            = <&gpio1 6 GPIO_ACTIVE_HIGH>
            , <&gpio0 9 GPIO_ACTIVE_HIGH>
            , <&gpio0 10 GPIO_ACTIVE_HIGH>;
        io-channels = <&adc 7>, <&adc 5>, <&adc 0>;
        polling-interval-ms = <5>;
        settle-time-us = <20>;
        press-threshold-mv = <1000>;
        release-threshold-mv = <1300>;
        /* Require ~3 consecutive 5ms scans (15ms) agreeing before latching a
         * transition. Hall output can hover right at the press/release
         * threshold (mechanical vibration, magnet wobble, ADC noise) even
         * while the finger is holding perfectly still; without this the
         * driver used to emit a burst of spurious press/release pairs at
         * scan rate whenever that happened, which could desync ZMK's
         * modifier reference counting and leave Ctrl/Alt/GUI stuck down on
         * the host with no USB/BLE disconnect involved. */
        debounce-press-ms = <15>;
        debounce-release-ms = <15>;
    };

    /* Wheel push only. The A/B rotation phases that used to live in
     * columns 1/2 here have moved to wheel_encoder above; this now only
     * scans the physical push button on P1.00 against the common P1.11. */
    kscan_wheel: kscan_wheel {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        debounce-press-ms = <10>;
        debounce-release-ms = <10>;
        diode-direction = "col2row";
        row-gpios = <&gpio1 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
        col-gpios = <&gpio1 0 GPIO_ACTIVE_HIGH>;
    };

    /* Only 20 physical keys now: the wheel's two rotation phases (formerly
     * the last two entries here, RC(3,1)/RC(3,2)) are no longer matrix
     * positions -- they are decoded by wheel_encoder/sensors above and
     * bound in the keymap via sensor-bindings instead of key bindings. */
    megknob_layout: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "MegKnob";
        keys
            = <&key_physical_attrs 100 100 600   0 0 0 0>
            , <&key_physical_attrs 100 100 700   0 0 0 0>
            , <&key_physical_attrs 100 100 800   0 0 0 0>
            , <&key_physical_attrs 100 100 900   0 0 0 0>
            , <&key_physical_attrs 100 100 1000  0 0 0 0>
            , <&key_physical_attrs 100 100 500 100 0 0 0>
            , <&key_physical_attrs 100 100 600 100 0 0 0>
            , <&key_physical_attrs 100 100 700 100 0 0 0>
            , <&key_physical_attrs 100 100 800 100 0 0 0>
            , <&key_physical_attrs 100 100 900 100 0 0 0>
            , <&key_physical_attrs 100 100 400 200 0 0 0>
            , <&key_physical_attrs 100 100 500 200 0 0 0>
            , <&key_physical_attrs 100 100 600 200 0 0 0>
            , <&key_physical_attrs 100 100 700 200 0 0 0>
            , <&key_physical_attrs 100 100 500 300 0 0 0>
            , <&key_physical_attrs 100 100 600 300 0 0 0>
            , <&key_physical_attrs 100 100 700 300 0 0 0>
            , <&key_physical_attrs 100 100 800 300 0 0 0>
            , <&key_physical_attrs 100 100 900 300 0 0 0>
            , <&key_physical_attrs 100 100   0 400 0 0 0>;
        transform = <&megknob_transform>;
    };

    megknob_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <8>;
        rows = <4>;
        map = <
            RC(2,2) RC(2,4) RC(1,2) RC(1,4) RC(0,4)
            RC(2,1) RC(2,6) RC(1,1) RC(1,6) RC(0,6)
            RC(2,0) RC(2,7) RC(1,0) RC(1,7)
            RC(2,3) RC(2,5) RC(1,3) RC(1,5) RC(0,7)
            RC(3,0)
        >;
    };
};

&adc {
    status = "okay";
    #address-cells = <1>;
    #size-cells = <0>;

    channel@0 {
        reg = <0>;
        zephyr,gain = "ADC_GAIN_1_6";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,input-positive = <NRF_SAADC_AIN0>;
        zephyr,resolution = <12>;
    };

    channel@5 {
        reg = <5>;
        zephyr,gain = "ADC_GAIN_1_6";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,input-positive = <NRF_SAADC_AIN5>;
        zephyr,resolution = <12>;
    };

    channel@7 {
        reg = <7>;
        zephyr,gain = "ADC_GAIN_1_6";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,input-positive = <NRF_SAADC_AIN7>;
        zephyr,resolution = <12>;
    };
};

&zephyr_udc0 {
    hall_telemetry_uart: hall_telemetry_uart {
        compatible = "zephyr,cdc-acm-uart";
    };
};

&pinctrl {
    megknob_spi3_default: megknob_spi3_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 1, 4)>;
        };
    };

    megknob_spi3_sleep: megknob_spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 1, 4)>;
            low-power-enable;
        };
    };
};

&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";

    pinctrl-0 = <&megknob_spi3_default>;
    pinctrl-1 = <&megknob_spi3_sleep>;
    pinctrl-names = "default", "sleep";

    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";
        reg = <0>;
        spi-max-frequency = <4000000>;

        chain-length = <19>;
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;

        color-mapping = <LED_COLOR_ID_GREEN LED_COLOR_ID_RED LED_COLOR_ID_BLUE>;
    };
};
