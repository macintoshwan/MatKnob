if SHIELD_MEGKNOB

config ZMK_KEYBOARD_NAME
    default "MegKnob"

config ZMK_BLE
    default y

config ZMK_USB
    default y

if ZMK_DISPLAY

choice ZMK_DISPLAY_STATUS_SCREEN
    default ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
endchoice

config I2C
    default y

config SSD1306
    default y

endif # ZMK_DISPLAY

if LVGL

config LV_Z_VDB_SIZE
    default 64

config LV_DPI_DEF
    default 148

config LV_Z_BITS_PER_PIXEL
    default 1

config LV_FONT_MONTSERRAT_12
    default y

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

endif # LVGL

if ZMK_BATTERY_REPORTING

choice ZMK_BATTERY_REPORTING_FETCH_MODE
    # Both nice!nano v1's voltage divider and v2's nRF VDDH sensor expose
    # battery voltage, not a fuel-gauge state-of-charge channel.
    default ZMK_BATTERY_REPORTING_FETCH_MODE_LITHIUM_VOLTAGE
endchoice

endif # ZMK_BATTERY_REPORTING

endif
