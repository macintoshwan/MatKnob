#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder>;
        triggers-per-rotation = <20>;
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Keyboard";
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
            bindings = <
                &kp TAB    &kp Q      &kp W       &kp E       &kp R
                &mo 1      &kp A      &kp S       &kp D       &kp F
                &kp LSHFT  &kp Z      &kp X       &kp C
                &kp BSPC   &kp LCTRL  &kp LGUI    &kp LALT    &kp SPACE
                &kp C_MUTE
            >;
        };

        function_layer {
            display-name = "Wireless / RGB";
            sensor-bindings = <&inc_dec_kp C_NEXT C_PREVIOUS>;
            bindings = <
                &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
                &trans         &bt BT_CLR    &out OUT_TOG  &out OUT_USB  &out OUT_BLE
                &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD
                &bootloader    &rgb_ug RGB_HUI  &rgb_ug RGB_HUD  &rgb_ug RGB_SAI  &rgb_ug RGB_SAD
                &kp C_PLAY_PAUSE
            >;
        };
    };
};
